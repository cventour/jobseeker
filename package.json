{
  "name": "jobseeker",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first job-search assistant. Reads your email, chats and calendar, finds roles worth your time, and each morning surfaces the few things that need you. Never applies or sends without your approval.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Christos Ventouris",
  "homepage": "https://myjobseeker.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cventour/jobseeker.git"
  },
  "bugs": {
    "url": "https://github.com/cventour/jobseeker/issues"
  },
  "keywords": [
    "job-search",
    "claude-code",
    "ai-agents",
    "local-first",
    "markdown",
    "macos",
    "automation"
  ],
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin"
  ],
  "scripts": {
    "dashboard": "node server/dashboard.mjs",
    "audit": "node server/audit.mjs",
    "check:urls": "node scripts/check-urls.mjs",
    "test:concurrency": "node scripts/test-concurrency.mjs",
    "guard": "bash scripts/rss-guard.sh",
    "icons": "python3 scripts/make-icons.py",
    "browser:probe": "node scripts/browser-do.mjs probe",
    "chat:sweep": "node scripts/browser-do.mjs chat-sweep",
    "board:sweep": "node scripts/browser-do.mjs board-sweep",
    "test:sweep": "node scripts/test-chat-sweep.mjs",
    "test:security": "node scripts/test-security.mjs",
    "test:welcome": "node scripts/test-welcome.mjs",
    "browser:install-agent": "bash scripts/install-browser-agent.sh",
    "setup": "bash scripts/setup.sh",
    "schedule": "bash scripts/set-schedule.sh",
    "mock:wizard": "node scripts/mock-wizard.mjs"
  }
}
